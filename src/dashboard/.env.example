# DewCall Dashboard — environment variables
# Copy this file to src/dashboard/.env and fill in your values.
# These are VITE_ prefixed and safe for the browser bundle (no secrets).

# Supabase (anon/public key only — never the service role key here)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# API base URL (Railway backend)
# Leave empty in development — Vite proxies /api/* automatically.
# Set to the full Railway URL for production builds.
VITE_API_URL=
